<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12(API 31) 이상의 백업·이전 규칙. 그 아래는 `backup_rules.xml`이 맡는다.
  **두 파일을 함께 고쳐야 한다** — 한쪽만 바꾸면 구형 기기에서 다른 동작을 한다.

  ## 왜 "전부 백업"도 "전부 제외"도 아닌가
  예전에는 이 파일이 Android Studio 템플릿 그대로(전부 주석)였다. 그러면 기본값이
  **전체 포함**이라 신체 정보까지 구글 서버로 올라간다. 그렇다고 `allowBackup="false"`로
  통째로 끄면, 서버 동기화가 아직 없는 이 앱에서는 **기기를 바꾸거나 앱을 지우는 순간
  운동 기록이 영영 사라진다.**

  실제로 계측 테스트가 앱을 제거하면서 기기에 쌓인 운동 기록을 전부 잃은 적이 있고,
  그때 백업 규칙이 비어 있어 복구하지 못했다 (`기술선택_기록.md` 94번).

  그래서 **나눈다** — 잃으면 되돌릴 수 없는 것은 올리고, 다시 입력하면 되는
  민감 정보는 올리지 않는다.
-->
<data-extraction-rules>

    <!--
      구글 계정 클라우드 백업. 사용자 통제 밖의 서버에 올라간다.

      · Room DB(`databases/formchecker.db`)는 **포함** — 서버 동기화가 붙기 전까지
        이것이 운동 기록의 유일한 안전망이다.
      · DataStore(`files/datastore/`)는 **제외** — 키·몸무게·나이·성별이 들어 있다.
        잃어도 설정에서 다시 넣으면 그만이라, 클라우드에 둘 이유가 없다.
      · 수집 데이터(`external`)는 **제외** — 개발·검증용이고 프레임마다 관절 좌표가
        쌓여 용량이 크다. 백업에 넣을 성격이 아니다.
    -->
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="external" path="." />
    </cloud-backup>

    <!--
      기기 간 직접 이전(새 폰으로 옮기기). 사용자가 직접 시작하고 데이터가 두 기기
      밖으로 나가지 않으므로, 신체 정보를 포함해 **전부 옮긴다** — 폰을 바꿨다고
      키·몸무게를 다시 입력하게 만들 이유가 없다.

      수집 데이터만 뺀다. 용량 문제이고 개발용이라 옮길 값이 없다.
    -->
    <device-transfer>
        <exclude domain="external" path="." />
    </device-transfer>

</data-extraction-rules>
